#!/bin/bash
# Daily ZFS snapshots and their cleanup, run by the zfs-snapshot-daily and
# zfs-snapshot-prune systemd timers.
#
#   zfs-snapshots create   snapshot every dataset as @daily-<timestamp>
#   zfs-snapshots prune    per dataset, destroy snapshots older than KEEP_DAYS,
#                          but never the newest KEEP_COUNT. This covers all
#                          snapshots of the dataset, also pre-emerge-* and
#                          pre-kupdate-* ones.
#   zfs-snapshots list     only print the snapshots prune would destroy
#
# Dataset names differ between machines, so the datasets are all ZFS
# filesystems found at run time, pool roots included. To leave one out:
#   zfs set com.sun:auto-snapshot=false <dataset>
# (the opt-out property zfs-auto-snapshot and sanoid use as well). Children
# inherit it, and opted-out datasets are neither snapshotted nor pruned.

KEEP_DAYS=7
KEEP_COUNT=7

# Fill DATASETS with every filesystem that isn't opted out. Exits if zfs
# can't list them, so the timer fails instead of silently doing nothing.
load_datasets() {
    local out
    if ! out=$(zfs list -H -t filesystem -o name,com.sun:auto-snapshot); then
        echo "Cannot list ZFS filesystems" >&2
        exit 1
    fi
    # NF skips the empty line <<< adds when there are no filesystems at all
    mapfile -t DATASETS < <(awk -F '\t' 'NF && $2 != "false" { print $1 }' <<< "${out}")
}

create() {
    local name ds failed=0
    name="daily-$(date +%Y%m%d-%H%M)"
    for ds in "${DATASETS[@]}"; do
        if zfs snapshot "${ds}@${name}"; then
            echo "Created ${ds}@${name}"
        else
            echo "Failed to create ${ds}@${name}" >&2
            failed=1
        fi
    done
    return "${failed}"
}

# Print the snapshots that are due: per dataset all but the newest KEEP_COUNT,
# and of those only the ones older than KEEP_DAYS.
print_expired() {
    local ds snaps snap creation i
    local cutoff=$(( $(date +%s) - KEEP_DAYS * 86400 ))
    for ds in "${DATASETS[@]}"; do
        # this dataset's own snapshots (-d 1), oldest first, creation in epoch seconds
        mapfile -t snaps < <(zfs list -H -p -t snapshot -d 1 -s creation -o name,creation "${ds}")
        for (( i = 0; i < ${#snaps[@]} - KEEP_COUNT; i++ )); do
            read -r snap creation <<< "${snaps[i]}"
            if (( creation < cutoff )); then
                echo "${snap}"
            fi
        done
    done
}

prune() {
    local snap failed=0
    while read -r snap; do
        if zfs destroy "${snap}"; then
            echo "Destroyed ${snap}"
        else
            echo "Failed to destroy ${snap}" >&2
            failed=1
        fi
    done < <(print_expired)
    return "${failed}"
}

if [[ ! "${1}" =~ ^(create|prune|list)$ ]]; then
    echo "Usage: ${0##*/} create|prune|list" >&2
    exit 2
fi

load_datasets
case "${1}" in
    create) create ;;
    prune) prune ;;
    list) print_expired ;;
esac
